# ---------------------------------------------------------------------------
# Clos Peyredoule - example environment. Copy to .env and adjust.
#   cp .env.example .env
# Never commit the real .env (it is gitignored).
# ---------------------------------------------------------------------------

# --- Runtime -------------------------------------------------------------
APP_ENV=development                 # development | production
LOG_LEVEL=INFO

# --- Database ------------------------------------------------------------
POSTGRES_USER=peyredoule
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_DB=peyredoule
POSTGRES_PORT=5433
# Used by the API container (host "db" is the compose service name).
DATABASE_URL=postgresql+asyncpg://peyredoule:change-me-in-local-env@db:5432/peyredoule

# --- Security ------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
APP_SECRET_KEY=dev-only-secret-change-me-0000000000000000000000000000000000
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Set to true whenever the site is served over HTTPS.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- First administrator (seeded on startup if the table is empty) -------
ADMIN_EMAIL=admin@clos-peyredoule.fr
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_FULL_NAME=Propriétaire

API_PORT=8001
WEB_PORT=5173

# --- URLs ----------------------------------------------------------------
# Base URL encoded into the property QR code (must be reachable by phones).
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Demo content --------------------------------------------------------
SEED_DEMO_CONTENT=true

# --- Frontend ------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8001
